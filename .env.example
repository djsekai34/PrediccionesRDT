# Firebase Console > Configuración del proyecto > Tus apps > App web > "Configuración del SDK"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Emails de admin (separados por comas). Solo sirve para mostrar/ocultar botones;
# la seguridad real son las reglas de firestore.rules.
VITE_ADMIN_EMAILS=TU_EMAIL@gmail.com
