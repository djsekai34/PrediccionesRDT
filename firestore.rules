rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estas cuentas de Google pueden escribir. Cambia el email por el tuyo (puedes poner varios).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['TU_EMAIL@gmail.com'];
    }

    // Cualquiera puede ver las predicciones y los premios reales; solo el admin escribe.
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
